import pandas as pd

# Load datasets
orders = pd.read_csv('orders.csv')
vehicles = pd.read_csv('vehicles.csv')

# 1. Check for inconsistent Zone names (This is a classic "fragmented" data problem)
print("Unique Pickup Zones in Orders:")
print(orders['pickup_zone'].unique())

print("\nUnique Assigned Zones in Vehicles:")
print(vehicles['assigned_zone'].unique())

# 2. Check for missing values in critical columns
print("\nMissing values in Deliveries:")
print(pd.read_csv('deliveries.csv').isnull().sum())
